# server/.env.example
# Every setting the Readeez server uses. server/setup.sh writes the real server/.env for
# you, or copy this file and fill it in by hand. The real .env is gitignored, holds secrets,
# and is included in every encrypted backup.

# --- Required ---------------------------------------------------------------------------

# The database password. Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Encrypts people's stored Nextcloud app passwords. Use: openssl rand -hex 32
# Changing it makes the saved ones unreadable, so everyone would need to reconnect.
SECRETS_KEY=change-me

# Encrypts server backups. Use: openssl rand -hex 32
# KEEP A COPY IN A PASSWORD MANAGER. The backup holds this file, so without a separate copy
# of this passphrase no backup can ever be opened.
BACKUP_PASSPHRASE=change-me

# --- Network ----------------------------------------------------------------------------

# The port on this machine for the API. Default 3020. Pick one nothing else is using.
READEEZ_PORT=3020

# The address that port listens on. Keep 127.0.0.1 when the reverse proxy is on this
# machine. Use this machine's private address only if the proxy is on another host, and
# firewall the port so only the proxy can reach it. Never expose it to the internet.
READEEZ_BIND=127.0.0.1

# How many reverse proxies sit in front of the API. 1 with one Caddy or Nginx. Rate limiting
# per address depends on this: too low and the whole family shares one limit, too high and
# a client can fake its address to dodge the limit.
TRUST_PROXY=1

# Websites allowed to call this API from a browser, comma-separated. Leave empty in
# production: the Android app doesn't need it.
CORS_ALLOWED_ORIGINS=

# This server's public address, e.g. https://readeez.example.com. update.sh checks it from
# the outside after each update. Empty skips that check.
PUBLIC_URL=

# --- Family members' Nextcloud exports --------------------------------------------------

# Private-network Nextcloud hosts people may connect, comma-separated, e.g. cloud.home.lan.
# Normally empty: anything private is refused, so accounts can't use this server to reach
# your internal network. Only list hosts you trust, since it also allows plain http to them.
NEXTCLOUD_ALLOWED_PRIVATE_HOSTS=

# --- Server backups to Nextcloud (read by backup.sh) ------------------------------------

# Where nightly encrypted backups go. Leave the address empty to keep backups on this
# machine only, which won't survive losing this machine.
BACKUP_NEXTCLOUD_URL=
BACKUP_NEXTCLOUD_USER=
# Use a Nextcloud app password, not the account's main password.
BACKUP_NEXTCLOUD_APP_PASSWORD=
# The folder in that Nextcloud account.
BACKUP_NEXTCLOUD_FOLDER=Readeez-backups
# How many backups to keep in each place.
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_REMOTE=30

# --- Update check -----------------------------------------------------------------------

# The GitHub repo whose version tags the admin Server panel compares against. Empty turns
# the check off.
UPDATE_CHECK_REPO=jasonhaymond/Readeez
