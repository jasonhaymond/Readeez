# .env.example
# Settings for building the Android app (scripts/build-android.mjs). Copy to .env, which is
# gitignored, on the machine that runs the build. Server settings are separate: see
# server/.env.example.

# The build server's API address, e.g. https://builds-api.example.com
BUILD_SERVER_API_URL=

# An API key from the build server (Profile > My API keys). It needs these scopes:
# build:create, build:read, build:logs, artifact:download, signing:use
BUILD_SERVER_API_KEY=

# The NAME of the Android signing key stored on the build server, e.g. readeez. The key
# itself never leaves the build server. Required for release builds.
BUILD_SERVER_SIGNING_KEY=readeez

# The Readeez server the app connects to, built into the APK, e.g. https://readeez.example.com
EXPO_PUBLIC_API_URL=
